    }

    function handleOptionSelect(mcqId, selectedIdx) {
      if (answeredTracker[mcqId] !== undefined) return;

      const mcq = mcqBank.find(q => q.id === mcqId);
      if (!mcq) return;

      answeredTracker[mcqId] = selectedIdx;
      const isCorrect = selectedIdx === mcq.correctIndex;
      if (isCorrect) currentQuizScore++;

      document.getElementById('quizScoreBadge').innerText = `Score: ${currentQuizScore} / ${mcqBank.length}`;

      // Style options
      for (let i = 0; i < mcq.options.length; i++) {
        const btn = document.getElementById(`optBtn_${mcqId}_${i}`);
        if (btn) {
          if (i === mcq.correctIndex) {
            btn.className = "p-2.5 rounded-xl bg-emerald-500/20 border border-emerald-500/50 text-emerald-300 font-bold text-left";
          } else if (i === selectedIdx && !isCorrect) {
            btn.className = "p-2.5 rounded-xl bg-rose-500/20 border border-rose-500/50 text-rose-300 text-left";
          } else {
            btn.className = "p-2.5 rounded-xl bg-slate-900/50 border border-slate-900 text-slate-500 text-left opacity-60";
          }
        }
      }

      document.getElementById(`explanation_${mcqId}`).classList.remove('hidden');
    }

    /* ==========================================================
       HIDDEN ADMIN PANEL & VERIFICATION CONTROLS
       ========================================================== */
    function openAdminGatewayModal() {
      document.getElementById('adminPanelModal').classList.remove('hidden');
      document.getElementById('adminPasswordGate').classList.remove('hidden');
      document.getElementById('adminDashboardContent').classList.add('hidden');
      document.getElementById('adminSecretKeyInput').value = "";
      document.getElementById('adminGateError').classList.add('hidden');
    }

    function closeAdminPanelModal() {
      document.getElementById('adminPanelModal').classList.add('hidden');
    }

    function verifyAdminPassword() {
      const pass = document.getElementById('adminSecretKeyInput').value.trim();
      if (pass === PLATFORM_CONFIG.adminPass) {
        document.getElementById('adminPasswordGate').classList.add('hidden');
        document.getElementById('adminDashboardContent').classList.remove('hidden');
        renderAdminDashboard();
      } else {
        document.getElementById('adminGateError').classList.remove('hidden');
      }
    }

    function renderAdminDashboard() {
      const pendingProofs = paymentProofs.filter(p => p.status === 'pending');
      const approvedProofs = paymentProofs.filter(p => p.status === 'approved');

      let revenue = 0;
      approvedProofs.forEach(p => revenue += (p.price || 0));

      document.getElementById('adminMetricPendingCount').innerText = pendingProofs.length;
      document.getElementById('adminMetricApprovedCount').innerText = approvedProofs.length;
      document.getElementById('adminMetricTotalRevenue').innerText = `₹${revenue}`;

      const container = document.getElementById('adminProofQueueList');
      if (paymentProofs.length === 0) {
        container.innerHTML = `<div class="p-4 text-center text-xs text-slate-500 border border-slate-800 rounded-xl">No transaction proofs registered yet.</div>`;
        return;
      }

      container.innerHTML = paymentProofs.map(p => `
        <div class="p-3.5 rounded-2xl bg-slate-950 border ${p.status === 'pending' ? 'border-amber-500/40 bg-amber-950/10' : 'border-slate-800'} space-y-2">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-xs font-bold text-white">${p.studentName} (+91 ${p.studentPhone})</p>
              <p class="text-[11px] text-cyan-300 font-medium">${p.docTitle}</p>
              <p class="text-[10px] text-slate-400 font-mono">UTR: <strong class="text-white">${p.utr}</strong> • Amount: <strong>₹${p.price}</strong></p>
            </div>
            <span class="text-[9px] px-2 py-0.5 rounded font-bold uppercase ${p.status === 'approved' ? 'bg-emerald-500/20 text-emerald-300' : (p.status === 'rejected' ? 'bg-rose-500/20 text-rose-300' : 'bg-amber-500/20 text-amber-300')}">
              ${p.status}
            </span>
          </div>

          <!-- Screenshot Preview -->
          ${p.screenshotBase64 ? `
            <div class="p-1.5 bg-slate-900 rounded-xl inline-block border border-slate-800">
              <img src="${p.screenshotBase64}" alt="Receipt" class="h-24 w-auto rounded object-cover cursor-pointer" onclick="window.open('${p.screenshotBase64}')">
            </div>
          ` : ''}

          ${p.status === 'pending' ? `
            <div class="flex items-center gap-2 pt-1 border-t border-slate-900">
              <button onclick="adminApproveProof('${p.id}')" class="flex-1 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition">
                <i class="fas fa-check mr-1"></i> Approve & Grant Lifetime
              </button>
              <button onclick="adminRejectProof('${p.id}')" class="py-1.5 px-3 bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 font-semibold text-xs rounded-xl border border-rose-500/40 transition">
                Reject
              </button>
            </div>
          ` : ''}
        </div>
      `).join('');
    }

    function adminApproveProof(proofId) {
      const proof = paymentProofs.find(p => p.id === proofId);
      if (!proof) return;

      proof.status = 'approved';
      saveStorage('payment_proofs', paymentProofs);

      // If active user is the student, grant permanent access
      if (currentUser && currentUser.phone === proof.studentPhone) {
        if (!currentUser.enrolledDocs) currentUser.enrolledDocs = [];
        if (!currentUser.enrolledDocs.includes(proof.docId)) {
          currentUser.enrolledDocs.push(proof.docId);
        }
        saveStorage('user', currentUser);
      }

      showToast(`Approved! Permanent access granted to ${proof.studentName}.`);
      renderAdminDashboard();
      renderStoreCards();
      renderMyLibraryList();
    }

    function adminRejectProof(proofId) {
      const proof = paymentProofs.find(p => p.id === proofId);
      if (!proof) return;

      if (confirm("Are you sure you want to reject this payment proof?")) {
        proof.status = 'rejected';
        saveStorage('payment_proofs', paymentProofs);

        // Revoke grace access
        if (currentUser && currentUser.phone === proof.studentPhone && currentUser.provisionalAccess) {
          delete currentUser.provisionalAccess[proof.docId];
          saveStorage('user', currentUser);
        }

        showToast("Payment proof rejected.");
        renderAdminDashboard();
        renderStoreCards();
        renderMyLibraryList();
      }
    }

    function exportPlatformDataBackup() {
      const dump = {
        platform: PLATFORM_CONFIG.name,
        exportedAt: new Date().toISOString(),
        paymentProofs,
        storeItems,
        affairsFeed
      };

      const blob = new Blob([JSON.stringify(dump, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `TargetCrack_Backup_${Date.now()}.json`;
      a.click();
    }

    /* ==========================================================
       UTILITY: INTERACTIVE TOAST NOTIFICATIONS
       ========================================================== */
    function showToast(msg) {
      const existing = document.getElementById('tcToastNotification');
      if (existing) existing.remove();

      const toast = document.createElement('div');
      toast.id = 'tcToastNotification';
      toast.className = "fixed top-5 left-1/2 -translate-x-1/2 z-50 bg-slate-900 border border-cyan-500/50 text-white text-xs px-4 py-2.5 rounded-2xl shadow-2xl flex items-center gap-2 max-w-sm w-auto text-center animate-bounce";
      toast.innerHTML = `<i class="fas fa-circle-info text-cyan-400"></i> <span>${msg}</span>`;
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 3500);
    }
  </script>
</body>
