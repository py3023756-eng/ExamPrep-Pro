<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#030712">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>TargetCrack Exam Vault - Premium Digital Study Platform</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Inter & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Outfit', 'sans-serif'],
          },
          colors: {
            vault: {
              950: '#030712',
              900: '#0b1120',
              850: '#0f172a',
              800: '#1e293b',
              700: '#334155',
              accent: '#38bdf8',
              cyan: '#06b6d4',
              emerald: '#10b981',
              amber: '#f59e0b',
              rose: '#f43f5e'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Anti-Piracy Document Protection */
    .unselectable {
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
    }
    
    @media print {
      body { display: none !important; }
    }

    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

    @keyframes watermarkFloat {
      0% { transform: translate(-20px, -15px) rotate(-25deg); opacity: 0.18; }
      50% { transform: translate(25px, 20px) rotate(-22deg); opacity: 0.28; }
      100% { transform: translate(-20px, -15px) rotate(-25deg); opacity: 0.18; }
    }
    .watermark-grid {
      animation: watermarkFloat 6s ease-in-out infinite;
      pointer-events: none;
    }
    
    .glass-card {
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(3, 7, 18, 0.95) 100%);
      backdrop-filter: blur(12px);
    }
  </style>
</head>

<body class="bg-vault-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-cyan-500 selection:text-white unselectable">

  <header class="bg-vault-900/95 backdrop-blur-md border-b border-slate-800/80 sticky top-0 z-40 px-4 py-2.5 shadow-xl">
    <div class="max-w-4xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo -->
      <div class="flex items-center space-x-2.5 cursor-pointer" onclick="navigateToTab('home')">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-sky-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-cyan-500/20 text-white font-black font-display text-lg tracking-wider">
          TC
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-base font-black font-display text-white tracking-tight">TargetCrack</span>
            <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">Vault Pro</span>
          </div>
          <p class="text-[10px] text-slate-400">All India Competitive Exam Hub</p>
        </div>
      </div>

      <!-- Action Nav -->
      <div class="flex items-center space-x-2">
        <button id="pwaInstallBtn" onclick="triggerPwaPrompt()" class="hidden text-xs bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-300 border border-cyan-500/40 px-2.5 py-1.5 rounded-xl font-semibold transition flex items-center gap-1">
          <i class="fas fa-download text-xs"></i>
          <span class="hidden sm:inline">Install App</span>
        </button>

        <div id="headerAuthSection" class="flex items-center gap-2">
          <!-- Populated by JS based on user state -->
        </div>
      </div>
    </div>
  </header>

  <div id="graceAccessAlertBar" class="hidden bg-gradient-to-r from-amber-600/30 via-amber-500/20 to-amber-600/30 border-b border-amber-500/40 px-4 py-2.5">
    <div class="max-w-4xl mx-auto flex items-center justify-between text-xs text-amber-200">
      <div class="flex items-center space-x-2">
        <span class="flex h-2.5 w-2.5 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
        </span>
        <p class="font-medium">
          <strong class="text-white">Provisional Access Active:</strong> Verifying Payment Proof. Auto expires in: <span id="graceCountdownTimer" class="font-mono font-bold text-amber-300 bg-amber-950/80 px-2 py-0.5 rounded border border-amber-500/30">11h 59m 50s</span>
        </p>
      </div>
      <button onclick="document.getElementById('graceAccessAlertBar').classList.add('hidden')" class="text-amber-400 hover:text-white text-xs ml-2">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>

  <main class="flex-1 max-w-4xl w-full mx-auto p-4 pb-28 space-y-5">
    
    <!-- TAB 1: HOME & AUTOMATED CURRENT AFFAIRS ENGINE -->
    <section id="tabHomeSection" class="space-y-5">
      
      <!-- Welcome Hero Banner -->
      <div class="glass-card rounded-3xl p-5 sm:p-6 border border-slate-800 shadow-2xl relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-52 h-52 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 w-52 h-52 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
              <i class="fas fa-bolt text-yellow-400"></i> Live Exam AI Updates
            </span>
            <span id="userExamTag" class="text-xs text-slate-300 bg-slate-800 px-3 py-1 rounded-full border border-slate-700 font-medium">
              Target: All Competitive Exams
            </span>
          </div>

          <h1 class="text-xl sm:text-2xl font-black font-display text-white tracking-tight leading-snug">
            Crack Your Exam With Topper Formula Books, PYQs & Verified Capsules.
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-2xl">
            Read in-app anytime without heavy downloads. Secure, anti-piracy protected, and updated automatically with daily PIB summaries.
          </p>

          <div class="pt-1 flex flex-wrap items-center gap-3">
            <button onclick="navigateToTab('store')" class="bg-gradient-to-r from-cyan-500 to-sky-500 hover:from-cyan-600 hover:to-sky-600 text-slate-950 font-black text-xs px-4 py-2.5 rounded-xl shadow-lg shadow-cyan-500/20 transition active:scale-95 flex items-center gap-1.5">
              <i class="fas fa-folder-open"></i>
              <span>Explore Notes Vault</span>
            </button>
            <button onclick="navigateToTab('quiz')" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs px-4 py-2.5 rounded-xl border border-slate-700 transition active:scale-95 flex items-center gap-1.5">
              <i class="fas fa-circle-question text-cyan-400"></i>
              <span>Daily Practice MCQs</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Automated Live Current Affairs Widget -->
      <div class="glass-card rounded-3xl p-5 border border-slate-800 shadow-xl space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800">
          <div>
            <h2 class="text-sm font-extrabold font-display uppercase tracking-wider text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
              <span>Automated Exam Current Affairs & PIB Feed</span>
            </h2>
            <p class="text-[11px] text-slate-400">Zero manual effort • Self-refreshed for UPSC, SSC, Railways, State PSC</p>
          </div>

          <!-- Time Range Filters -->
          <div class="flex items-center gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800 self-start sm:self-center">
            <button onclick="switchAffairsFilter('daily')" id="filterDailyBtn" class="px-3 py-1 text-xs font-bold rounded-lg bg-cyan-500 text-slate-950 transition">Daily</button>
            <button onclick="switchAffairsFilter('weekly')" id="filterWeeklyBtn" class="px-3 py-1 text-xs font-medium text-slate-400 hover:text-white rounded-lg transition">Weekly</button>
            <button onclick="switchAffairsFilter('monthly')" id="filterMonthlyBtn" class="px-3 py-1 text-xs font-medium text-slate-400 hover:text-white rounded-lg transition">Monthly</button>
          </div>
        </div>

        <div id="affairsFeedList" class="space-y-2.5 max-h-[380px] overflow-y-auto pr-1 scrollbar-none">
          <!-- Dynamic News Items Inserted by JS -->
        </div>
      </div>

    </section>

    <!-- TAB 2: STUDY VAULT & EXAM MATERIAL STORE -->
    <section id="tabStoreSection" class="hidden space-y-5">
      
      <!-- Store Filters Bar -->
      <div class="glass-card rounded-2xl p-4 border border-slate-800 space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-black font-display text-white flex items-center gap-2">
              <i class="fas fa-boxes-stacked text-cyan-400"></i>
              <span>Exam Notes & PYQ Store</span>
            </h2>
            <p class="text-xs text-slate-400">Read in secure in-app viewer. First 3 pages free preview on all titles.</p>
          </div>

          <!-- Search Input -->
          <div class="relative">
            <i class="fas fa-search absolute left-3 top-2.5 text-xs text-slate-500"></i>
            <input type="text" id="storeSearchInput" onkeyup="filterStoreMaterials()" placeholder="Search notes, PYQs, exam..." class="bg-slate-950 border border-slate-800 text-xs text-slate-200 pl-8 pr-3 py-2 rounded-xl w-full sm:w-64 focus:border-cyan-400 outline-none">
          </div>
        </div>

        <!-- Exam Category Pill Filters -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none text-xs">
          <button onclick="filterStoreCategory('ALL')" class="store-filter-btn px-3 py-1.5 rounded-xl font-bold bg-cyan-500 text-slate-950 shrink-0">All Titles</button>
          <button onclick="filterStoreCategory('SSC')" class="store-filter-btn px-3 py-1.5 rounded-xl font-medium bg-slate-900 border border-slate-800 text-slate-300 shrink-0">SSC (CGL/GD/CHSL)</button>
          <button onclick="filterStoreCategory('POLICE')" class="store-filter-btn px-3 py-1.5 rounded-xl font-medium bg-slate-900 border border-slate-800 text-slate-300 shrink-0">State Police (UP/Bihar)</button>
          <button onclick="filterStoreCategory('RAILWAY')" class="store-filter-btn px-3 py-1.5 rounded-xl font-medium bg-slate-900 border border-slate-800 text-slate-300 shrink-0">Railways RRB</button>
          <button onclick="filterStoreCategory('DEFENCE')" class="store-filter-btn px-3 py-1.5 rounded-xl font-medium bg-slate-900 border border-slate-800 text-slate-300 shrink-0">Defence (NDA/CDS)</button>
          <button onclick="filterStoreCategory('GK')" class="store-filter-btn px-3 py-1.5 rounded-xl font-medium bg-slate-900 border border-slate-800 text-slate-300 shrink-0">Static GK & Formulas</button>
        </div>
      </div>

      <!-- Store Material Grid -->
      <div id="storeCardsContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Rendered by JS -->
      </div>
    </section>

    <!-- TAB 3: DAILY PRACTICE QUIZ WITH DETAILED EXPLANATIONS -->
    <section id="tabQuizSection" class="hidden space-y-4">
      <div class="glass-card rounded-3xl p-5 border border-slate-800">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
          <div>
            <h2 class="text-base font-black font-display text-white flex items-center gap-2">
              <i class="fas fa-brain text-cyan-400"></i>
              <span>Daily High-Yield MCQ Challenge</span>
            </h2>
            <p class="text-xs text-slate-400">Practice real exam-pattern questions with instant explanations</p>
          </div>
          <div class="text-right">
            <span id="quizScoreBadge" class="text-xs font-mono font-bold bg-cyan-950 text-cyan-300 px-3 py-1 rounded-xl border border-cyan-800">Score: 0 / 5</span>
          </div>
        </div>

        <div id="quizQuestionsContainer" class="space-y-4">
          <!-- Rendered by JS -->
        </div>
      </div>
    </section>

    <!-- TAB 4: MY PURCHASED LIBRARY VAULT -->
    <section id="tabMyLibrarySection" class="hidden space-y-4">
      <div class="glass-card rounded-3xl p-5 border border-slate-800">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
          <div>
            <h2 class="text-base font-black font-display text-white flex items-center gap-2">
              <i class="fas fa-bookmark text-emerald-400"></i>
              <span>My Enrolled Vault & Active Passes</span>
            </h2>
            <p class="text-xs text-slate-400">Your unlocked and provisional notes ready for reading</p>
          </div>
        </div>

        <div id="myLibraryListContainer" class="space-y-3">
          <!-- Rendered by JS -->
        </div>
      </div>
    </section>

  </main>

  <nav class="fixed bottom-0 left-0 right-0 bg-vault-900/95 backdrop-blur-md border-t border-slate-800 py-2 px-4 z-30">
    <div class="max-w-md mx-auto flex items-center justify-around">
      <button onclick="navigateToTab('home')" id="bottomNavHome" class="flex flex-col items-center gap-0.5 text-cyan-400 transition">
        <i class="fas fa-house text-base"></i>
        <span class="text-[10px] font-bold">Feed</span>
      </button>

      <button onclick="navigateToTab('store')" id="bottomNavStore" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-slate-200 transition">
        <i class="fas fa-store text-base"></i>
        <span class="text-[10px] font-medium">Notes Vault</span>
      </button>

      <button onclick="navigateToTab('quiz')" id="bottomNavQuiz" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-slate-200 transition">
        <i class="fas fa-circle-question text-base"></i>
        <span class="text-[10px] font-medium">Daily MCQs</span>
      </button>

      <button onclick="navigateToTab('mylibrary')" id="bottomNavLibrary" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-slate-200 transition">
        <i class="fas fa-book-bookmark text-base"></i>
        <span class="text-[10px] font-medium">My Shelf</span>
      </button>

      <button onclick="openAdminGatewayModal()" class="flex flex-col items-center gap-0.5 text-slate-500 hover:text-amber-400 transition">
        <i class="fas fa-shield-halved text-base"></i>
        <span class="text-[10px] font-medium">Admin</span>
      </button>
    </div>
  </nav>

  <div id="secureReaderModal" class="fixed inset-0 bg-black/95 backdrop-blur-xl z-50 flex flex-col hidden select-none">
    
    <!-- Reader Top Navigation Bar -->
    <div class="bg-vault-900 border-b border-slate-800 px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-3 overflow-hidden">
        <button onclick="closeSecureReader()" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition">
          <i class="fas fa-arrow-left text-xs"></i>
        </button>
        <div>
          <h3 id="readerDocTitle" class="text-xs sm:text-sm font-bold text-white truncate max-w-xs sm:max-w-md">Document Title</h3>
          <p id="readerAccessStatusBadge" class="text-[10px] text-emerald-400 flex items-center gap-1">
            <i class="fas fa-lock-open text-[9px]"></i> Free 3-Page Preview Mode
          </p>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <span id="readerPageIndicator" class="text-xs font-mono font-bold bg-slate-950 px-2.5 py-1 rounded-lg border border-slate-800 text-cyan-300">
          Page 1 / 3
        </span>
        <button onclick="triggerReaderBuyPrompt()" id="readerUnlockFullBtn" class="text-xs bg-gradient-to-r from-cyan-500 to-sky-500 hover:from-cyan-600 text-slate-950 font-black px-3 py-1.5 rounded-xl shadow-md transition">
          Unlock Full (₹29)
        </button>
      </div>
    </div>

    <!-- Reader Anti-Piracy Document Viewport with Canvas Canvas Simulation -->
    <div class="flex-1 overflow-y-auto p-4 flex justify-center items-start bg-slate-950 relative">
      
      <!-- Anti-Piracy Watermark Overlay (Displays Student Name & Phone Diagonally) -->
      <div id="readerWatermarkContainer" class="absolute inset-0 z-20 pointer-events-none flex flex-wrap justify-around items-around opacity-25 overflow-hidden">
        <!-- Injected via JavaScript -->
      </div>

      <!-- Document Page Sheet -->
      <div class="max-w-xl w-full bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl relative z-10 space-y-5 text-slate-200">
        
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold text-cyan-400">TargetCrack Certified Study Content</span>
          </div>
          <span class="text-[10px] text-slate-500 font-mono" id="readerDocSubject">Subject</span>
        </div>

        <div id="readerPageContentArea" class="space-y-4 text-xs sm:text-sm leading-relaxed">
          <!-- Page text rendered by JS -->
        </div>

        <!-- Locked Page Overlay (Shown after Page 3 if unpaid) -->
        <div id="readerLockedOverlay" class="hidden rounded-2xl bg-gradient-to-b from-slate-900/90 to-slate-950 p-6 border border-cyan-500/40 text-center space-y-3 mt-4">
          <div class="w-12 h-12 mx-auto rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-xl">
            <i class="fas fa-lock"></i>
          </div>
          <h4 class="text-sm font-extrabold text-white">Remaining 42 Pages Are Locked</h4>
          <p class="text-xs text-slate-400 max-w-sm mx-auto">
            You have reached the end of the free 3-page preview. Unlock permanent full access or instant 12-hour grace review for just ₹29.
          </p>
          <button onclick="openPaymentModalForCurrentDoc()" class="py-2.5 px-6 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 text-white font-extrabold text-xs rounded-xl shadow-lg transition active:scale-95">
            <i class="fas fa-unlock-keyhole mr-1"></i> Unlock Full Document (₹29)
          </button>
        </div>

        <!-- Page Switchers -->
        <div class="flex items-center justify-between pt-4 border-t border-slate-800">
          <button onclick="prevReaderPage()" id="readerPrevBtn" class="text-xs px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold transition disabled:opacity-40">
            <i class="fas fa-chevron-left mr-1"></i> Previous Page
          </button>
          <button onclick="nextReaderPage()" id="readerNextBtn" class="text-xs px-3 py-1.5 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold transition disabled:opacity-40">
            Next Page <i class="fas fa-chevron-right ml-1"></i>
          </button>
        </div>

      </div>
    </div>
  </div>

  <div id="paymentProofModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden overflow-y-auto">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-md w-full p-6 shadow-2xl relative space-y-4">
      <button onclick="closePaymentModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
        <i class="fas fa-times"></i>
      </button>

      <div class="flex items-center space-x-2.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg font-black">
          <i class="fas fa-qrcode"></i>
        </div>
        <div>
          <h3 class="text-base font-extrabold text-white">Instant UPI Pay & 12h Grace Unlock</h3>
          <p class="text-xs text-slate-400">Zero wait: Get immediate 12-hour access upon upload</p>
        </div>
      </div>

      <!-- Item Details & Amount -->
      <div class="bg-slate-950 p-3 rounded-2xl border border-slate-800 flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-white truncate max-w-[200px]" id="payItemTitle">Title Name</p>
          <p class="text-[10px] text-emerald-400 font-medium">Includes 12h Provisional Access + Lifetime Backup</p>
        </div>
        <div class="text-right">
          <span class="text-lg font-black font-display text-cyan-300" id="payItemPrice">₹29</span>
        </div>
      </div>

      <!-- Official QR Section -->
      <div class="bg-white p-4 rounded-2xl max-w-[210px] mx-auto text-center shadow-lg">
        <!-- SVG Generated QR code visual representation -->
        <svg class="w-full h-auto" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="100" height="100" fill="white"/>
          <!-- Position Marks -->
          <rect x="5" y="5" width="26" height="26" fill="#091e3a"/>
          <rect x="9" y="9" width="18" height="18" fill="white"/>
          <rect x="13" y="13" width="10" height="10" fill="#091e3a"/>
          
          <rect x="69" y="5" width="26" height="26" fill="#091e3a"/>
          <rect x="73" y="9" width="18" height="18" fill="white"/>
          <rect x="77" y="13" width="10" height="10" fill="#091e3a"/>

          <rect x="5" y="69" width="26" height="26" fill="#091e3a"/>
          <rect x="9" y="73" width="18" height="18" fill="white"/>
          <rect x="13" y="77" width="10" height="10" fill="#091e3a"/>

          <!-- Dynamic QR Dots -->
          <rect x="36" y="10" width="5" height="5" fill="#091e3a"/>
