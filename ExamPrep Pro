      // Update deep-links for UPI Apps with proper amount
      const upiUrl = `upi://pay?pa=${PLATFORM_CONFIG.upiId}&pn=TargetCrack&am=${item.price}&cu=INR&tn=${encodeURIComponent(item.title)}`;
      document.getElementById('intentGPayBtn').href = upiUrl;
