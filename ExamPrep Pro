    function handleScreenshotUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        uploadedScreenshotBase64 = evt.target.result;
        document.getElementById('screenshotPreviewImg').src = uploadedScreenshotBase64;
        document.getElementById('screenshotPreviewBox').classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    }

    function submitPaymentProof(e) {
      e.preventDefault();
      if (!pendingPaymentItem || !currentUser) return;

      const utr = document.getElementById('inputPayUtr').value.trim();
      if (!utr || utr.length !== 12) {
        showToast("Please enter a valid 12-digit UPI UTR number.");
        return;
      }

      if (!uploadedScreenshotBase64) {
        showToast("Please attach the payment screenshot as proof.");
        return;
      }

      const proofEntry = {
        id: "proof_" + Date.now(),
        studentName: currentUser.name,
        studentPhone: currentUser.phone,
        docId: pendingPaymentItem.id,
        docTitle: pendingPaymentItem.title,
        price: pendingPaymentItem.price,
        utr: utr,
        screenshotBase64: uploadedScreenshotBase64,
        timestamp: Date.now(),
        status: "pending"
      };

      paymentProofs.unshift(proofEntry);
      saveStorage('payment_proofs', paymentProofs);

      // Activate 12-Hour Provisional Access immediately
      if (!currentUser.provisionalAccess) currentUser.provisionalAccess = {};
      currentUser.provisionalAccess[pendingPaymentItem.id] = Date.now() + (PLATFORM_CONFIG.graceDurationHours * 3600 * 1000);
      saveStorage('user', currentUser);

      closePaymentModal();
      showToast("Payment proof received! 12-Hour Provisional Full Access Activated.");
      
      checkActiveGracePeriods();
      renderStoreCards();
      renderMyLibraryList();

      if (currentReadingDoc && currentReadingDoc.id === pendingPaymentItem.id) {
        renderReaderPageContent();
      }
    }

    function isProvisionalActive(docId) {
      if (!currentUser || !currentUser.provisionalAccess || !currentUser.provisionalAccess[docId]) {
        return false;
      }
      return Date.now() < currentUser.provisionalAccess[docId];
    }

    function checkActiveGracePeriods() {
      if (!currentUser || !currentUser.provisionalAccess) {
        document.getElementById('graceAccessAlertBar').classList.add('hidden');
        return;
      }

      let activeDocId = null;
      let minRemainingMs = Infinity;

      Object.keys(currentUser.provisionalAccess).forEach(docId => {
        const remaining = currentUser.provisionalAccess[docId] - Date.now();
        if (remaining > 0 && remaining < minRemainingMs) {
          minRemainingMs = remaining;
          activeDocId = docId;
        }
      });

      if (activeDocId && minRemainingMs > 0) {
        const hh = String(Math.floor(minRemainingMs / 3600000)).padStart(2, '0');
        const mm = String(Math.floor((minRemainingMs % 3600000) / 60000)).padStart(2, '0');
        const ss = String(Math.floor((minRemainingMs % 60000) / 1000)).padStart(2, '0');

        document.getElementById('graceCountdownTimer').innerText = `${hh}h ${mm}m ${ss}s`;
        document.getElementById('graceAccessAlertBar').classList.remove('hidden');
      } else {
        document.getElementById('graceAccessAlertBar').classList.add('hidden');
      }
    }

